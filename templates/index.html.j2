<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ meta.title }} · {{ meta.tagline }}</title>
<meta name="description" content="{{ meta.tagline }} A weekly hand-picked music playlist by {{ meta.curator }}." />
<meta property="og:title" content="{{ meta.title }} — Weekly Music Playlist" />
<meta property="og:description" content="{{ meta.tagline }}" />
<meta property="og:type" content="website" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
<style>
  :root {
    --bg: #000000;
    --panel: rgba(255, 255, 255, 0.06);
    --panel-strong: rgba(255, 255, 255, 0.12);
    --border: rgba(255, 255, 255, 0.14);
    --text: #ffffff;
    --muted: #c8c8d6;
    --accent: #7c5cff;
    --player-h: 104px;
    --radius: 18px;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; scroll-padding-top: 130px; }

  body {
    margin: 0;
    font-family: 'Inter', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    padding-bottom: calc(var(--player-h) + 28px);
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ---------- animated aurora background ---------- */
  .aurora { position: fixed; inset: 0; z-index: -2; overflow: hidden; }
  .aurora span {
    position: absolute;
    width: 55vmax; height: 55vmax;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
    mix-blend-mode: screen;
    animation: drift 22s ease-in-out infinite;
  }
  .aurora .b1 { background: #7c5cff; top: -18%; left: -10%; }
  .aurora .b2 { background: #ff5c8a; top: 20%; right: -15%; animation-delay: -6s; }
  .aurora .b3 { background: #22c98b; bottom: -25%; left: 15%; animation-delay: -12s; }
  .aurora .b4 { background: #3bc9ff; bottom: -10%; right: 10%; animation-delay: -3s; }
  .grain { position: fixed; inset: 0; z-index: -1; opacity: 0.05;
    background-image: radial-gradient(rgba(255,255,255,0.6) 1px, transparent 1px);
    background-size: 3px 3px; pointer-events: none; }

  /* ---------- swimming 3D silverbass ---------- */
  .ocean { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .fish {
    position: absolute;
    left: -25vw;
    will-change: transform;
    filter: drop-shadow(0 18px 28px rgba(0,0,0,0.55));
    animation-name: swim;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    pointer-events: auto;
    cursor: pointer;
  }
  .fish:hover { filter: drop-shadow(0 0 18px var(--accent)) drop-shadow(0 18px 28px rgba(0,0,0,0.55)); }
  .fish .bob { display: block; width: 100%; height: auto; animation: bob 3.4s ease-in-out infinite; }
  /* fish swimming the other way get flipped to face their direction */
  .fish.rtl { left: auto; right: -25vw; animation-name: swimBack; }
  .fish.rtl .bob { transform: scaleX(-1); }

  @keyframes swim {
    0%   { transform: translateX(0) rotate(-2deg); }
    100% { transform: translateX(150vw) rotate(2deg); }
  }
  @keyframes swimBack {
    0%   { transform: translateX(0) rotate(2deg); }
    100% { transform: translateX(-150vw) rotate(-2deg); }
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-1.5deg); }
    50%      { transform: translateY(-22px) rotate(1.5deg); }
  }
  .fish.rtl .bob {
    animation-name: bobFlip;
  }
  @keyframes bobFlip {
    0%, 100% { transform: scaleX(-1) translateY(0) rotate(1.5deg); }
    50%      { transform: scaleX(-1) translateY(-22px) rotate(-1.5deg); }
  }
  @media (prefers-reduced-motion: reduce) { .fish { display: none; } }

  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(6%, 8%) scale(1.12); }
    66% { transform: translate(-7%, -5%) scale(0.92); }
  }

  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 22px; position: relative; z-index: 1; }

  /* ---------- hero ---------- */
  header.hero { padding: 90px 0 30px; text-align: center; position: relative; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--muted); font-weight: 600;
    padding: 7px 16px; border: 1px solid var(--border); border-radius: 999px;
    background: var(--panel); backdrop-filter: blur(12px);
  }
  .eyebrow .dot { width: 7px; height: 7px; border-radius: 50%; background: #22c98b;
    box-shadow: 0 0 10px #22c98b; animation: pulse 2s infinite; }
  @keyframes pulse { 50% { opacity: 0.35; } }

  h1.logo {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(3rem, 9vw, 6.5rem);
    font-weight: 700; line-height: 1; margin: 22px 0 14px;
    background: linear-gradient(110deg, #fff 10%, #b9a7ff 35%, #ff8fb3 60%, #6ee7c7 90%);
    background-size: 220% auto;
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 7s linear infinite;
  }
  @keyframes shimmer { to { background-position: 220% center; } }
  .tagline { color: var(--muted); font-size: clamp(1rem, 2.2vw, 1.3rem); max-width: 540px; margin: 0 auto; }

  .stats { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 30px; }
  .stat { background: var(--panel); border: 1px solid var(--border); border-radius: 14px;
    padding: 14px 22px; backdrop-filter: blur(12px); min-width: 110px; }
  .stat b { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 1.7rem; }
  .stat span { font-size: 0.74rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }

  /* ---------- sticky toolbar ---------- */
  .toolbar {
    position: sticky; top: 14px; z-index: 40;
    margin: 38px auto 10px;
    display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    padding: 12px; border-radius: 16px;
    background: rgba(14, 14, 22, 0.72); border: 1px solid var(--border);
    backdrop-filter: blur(18px); box-shadow: 0 14px 40px rgba(0,0,0,0.45);
  }
  .search { position: relative; flex: 1 1 230px; }
  .search input {
    width: 100%; padding: 12px 14px 12px 42px; border-radius: 12px;
    border: 1px solid var(--border); background: rgba(0,0,0,0.3);
    color: var(--text); font-size: 0.95rem; outline: none; transition: border .2s, box-shadow .2s;
  }
  .search input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(124,92,255,0.25); }
  .search svg { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip {
    border: 1px solid var(--border); background: var(--panel); color: var(--muted);
    padding: 9px 15px; border-radius: 999px; font-size: 0.85rem; font-weight: 600;
    cursor: pointer; transition: all .18s; white-space: nowrap;
  }
  .chip:hover { color: var(--text); border-color: rgba(255,255,255,0.25); }
  .chip.active { background: #fff; color: #0a0a12; border-color: #fff; }
  .shuffle-all {
    display: inline-flex; align-items: center; gap: 7px;
    border: none; cursor: pointer; padding: 11px 18px; border-radius: 12px;
    font-weight: 700; font-size: 0.9rem; color: #0a0a12;
    background: linear-gradient(120deg, #6ee7c7, #b9a7ff); transition: transform .15s, filter .15s;
  }
  .shuffle-all:hover { transform: translateY(-1px); filter: brightness(1.08); }

  /* ---------- playlist sections ---------- */
  section.set { margin-top: 46px; scroll-margin-top: 130px; }
  .set-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 20px; flex-wrap: wrap; }
  .set-head .emoji { font-size: 1.9rem; }
  .set-head h2 { font-family: 'Space Grotesk', sans-serif; font-size: clamp(1.5rem, 4vw, 2.2rem); margin: 0; }
  .set-head .genre { color: var(--muted); font-size: 0.85rem; padding: 4px 12px; border: 1px solid var(--border);
    border-radius: 999px; }
  .set-head .count { color: var(--muted); font-size: 0.85rem; margin-left: auto; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 18px; }

  .card {
    position: relative; border-radius: var(--radius); overflow: hidden; cursor: pointer;
    background: var(--panel); border: 1px solid var(--border);
    transition: transform .22s cubic-bezier(.2,.7,.3,1), box-shadow .22s, border-color .22s;
  }
  .card:hover { transform: translateY(-6px); border-color: var(--card-accent, var(--accent)); }
  .card:hover { box-shadow: 0 18px 40px rgba(0,0,0,0.5), 0 0 0 1px var(--card-accent, var(--accent)); }
  .thumb { position: relative; aspect-ratio: 16/10; overflow: hidden; background: #15151f; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s, filter .3s; }
  .card:hover .thumb img { transform: scale(1.08); filter: brightness(.7); }
  .thumb::after { content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,0.55)); }
  .play-btn {
    position: absolute; bottom: 12px; right: 12px; z-index: 2;
    width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center;
    background: var(--card-accent, var(--accent)); color: #fff;
    transform: translateY(8px) scale(.85); opacity: 0; transition: all .22s;
    box-shadow: 0 8px 20px rgba(0,0,0,0.45);
  }
  .card:hover .play-btn { transform: translateY(0) scale(1); opacity: 1; }
  .card.playing .play-btn { transform: none; opacity: 1; }
  .card-meta { padding: 14px 15px 16px; }
  .card-meta .t { font-weight: 600; font-size: 0.98rem; line-height: 1.25;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card-meta .a { color: var(--muted); font-size: 0.84rem; margin-top: 4px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card.playing { border-color: var(--card-accent); }
  .eq { display: none; gap: 2px; align-items: flex-end; height: 14px; margin-top: 8px; }
  .card.playing .eq { display: flex; }
  .eq i { width: 3px; background: var(--card-accent); border-radius: 2px; animation: bounce 0.9s ease-in-out infinite; }
  .eq i:nth-child(2){ animation-delay:.2s } .eq i:nth-child(3){ animation-delay:.4s } .eq i:nth-child(4){ animation-delay:.1s }
  @keyframes bounce { 0%,100%{ height:4px } 50%{ height:14px } }

  .empty { text-align: center; color: var(--muted); padding: 60px 0; display: none; }

  footer { text-align: center; padding: 60px 0 20px; color: var(--muted); }
  footer a { color: var(--text); text-decoration: none; border-bottom: 1px solid var(--border); }
  footer a:hover { border-color: var(--accent); }
  footer .socials { display: flex; gap: 14px; justify-content: center; margin-bottom: 18px; }
  footer .socials a { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px;
    background: var(--panel); border: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  footer .socials a:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); transition:.2s; }

  /* ---------- now playing bar ---------- */
  .nb-art { position: relative; width: 132px; height: 74px; border-radius: 10px; overflow: hidden;
    flex: none; background: #15151f; box-shadow: 0 6px 18px rgba(0,0,0,0.5); }
  .nb-art #yt-player, .nb-art iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 1; }
  .nowbar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
    transform: translateY(120%); transition: transform .35s cubic-bezier(.2,.8,.2,1);
    background: rgba(12, 12, 19, 0.86); backdrop-filter: blur(22px);
    border-top: 1px solid var(--border);
  }
  .nowbar.show { transform: translateY(0); }
  .nb-progress { height: 4px; background: rgba(255,255,255,0.08); cursor: pointer; position: relative; }
  .nb-progress .fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--accent), #ff8fb3); position: relative; }
  .nb-progress .fill::after { content:""; position:absolute; right:-5px; top:50%; transform:translateY(-50%);
    width:10px; height:10px; border-radius:50%; background:#fff; opacity:0; transition:.15s; }
  .nb-progress:hover .fill::after { opacity:1; }
  .nb-inner { display: flex; align-items: center; gap: 16px; padding: 12px 22px; max-width: 1280px; margin: 0 auto;
    height: var(--player-h); }
  .nb-cover { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .nb-info { min-width: 0; flex: 1 1 auto; }
  .nb-info .t { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nb-info .a { color: var(--muted); font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .nb-controls { display: flex; align-items: center; gap: 6px; }
  .nb-btn { background: none; border: none; color: var(--text); cursor: pointer; width: 42px; height: 42px;
    border-radius: 50%; display: grid; place-items: center; transition: background .15s, color .15s; }
  .nb-btn:hover { background: var(--panel-strong); }
  .nb-btn.active { color: var(--accent); }
  .nb-play { background: #fff; color: #0a0a12; width: 50px; height: 50px; }
  .nb-play:hover { background: #fff; transform: scale(1.05); transition: transform .15s; }
  .nb-time { font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums; min-width: 92px; text-align: right; }
  .nb-time .open { color: var(--text); margin-left: 10px; text-decoration: none; border-bottom: 1px solid var(--border); }

  @media (max-width: 720px) {
    .nb-time, .set-head .genre { display: none; }
    .nb-inner { gap: 10px; padding: 10px 14px; }
    .toolbar { top: 8px; }
    header.hero { padding: 60px 0 16px; }
  }

  /* ---------- like / favorite ---------- */
  .like {
    position: absolute; top: 10px; right: 10px; z-index: 3;
    width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2); color: #fff;
    cursor: pointer; opacity: 0; transform: scale(.8); transition: all .2s; backdrop-filter: blur(6px);
  }
  .card:hover .like { opacity: 1; transform: none; }
  .like.liked { opacity: 1; transform: none; color: #ff5c8a; border-color: #ff5c8a;
    background: rgba(255,92,138,0.15); }
  .like:hover { transform: scale(1.12); }
  .like svg { width: 18px; height: 18px; }
  .like.liked svg path, #btnLike.liked svg path { fill: currentColor; }

  /* ---------- toolbar extra buttons ---------- */
  .ghost-btn {
    display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
    border: 1px solid var(--border); background: var(--panel); color: var(--text);
    padding: 11px 16px; border-radius: 12px; font-weight: 700; font-size: 0.9rem; transition: all .15s;
  }
  .ghost-btn:hover { border-color: var(--accent); transform: translateY(-1px); }

  /* ---------- now-playing visualizer ---------- */
  .viz { position: absolute; left: 0; right: 0; top: 0; transform: translateY(-100%);
    height: 44px; display: flex; align-items: flex-end; gap: 3px; padding: 0 16px;
    pointer-events: none; opacity: 0; transition: opacity .4s; }
  .nowbar.playing .viz { opacity: .9; }
  .viz i { flex: 1; height: 4px; border-radius: 3px 3px 0 0;
    background: linear-gradient(180deg, var(--accent), transparent); }
  .nowbar.playing .viz i { animation: vizBar .9s ease-in-out infinite; }
  @keyframes vizBar { 0%,100% { height: 4px; } 50% { height: 40px; } }

  .nb-btn.like.liked, #btnLike.liked { color: #ff5c8a; }
  #btnLike { position: static; width: 42px; height: 42px; opacity: 1; transform: none; background: none; border: none; }
  #btnLike:hover { background: var(--panel-strong); }
  #btnLike.liked { color: #ff5c8a; }

  /* ---------- bubbles ---------- */
  .bubble { position: absolute; bottom: -50px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle at 32% 30%, rgba(255,255,255,0.7), rgba(124,92,255,0.12));
    border: 1px solid rgba(255,255,255,0.18); animation: rise linear infinite; }
  @keyframes rise {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    12% { opacity: .65; }
    100% { transform: translateY(-110vh) translateX(28px); opacity: 0; }
  }

  /* ---------- toast ---------- */
  .toast { position: fixed; left: 50%; bottom: calc(var(--player-h) + 26px); z-index: 80;
    transform: translate(-50%, 18px); background: rgba(18,18,28,0.96); border: 1px solid var(--border);
    padding: 12px 18px; border-radius: 12px; backdrop-filter: blur(12px); box-shadow: 0 12px 30px rgba(0,0,0,0.5);
    opacity: 0; pointer-events: none; transition: all .3s cubic-bezier(.2,.8,.2,1); max-width: 90vw;
    font-size: 0.92rem; display: flex; align-items: center; gap: 10px; }
  .toast.show { opacity: 1; transform: translate(-50%, 0); }
  .toast b { color: var(--accent); }

  /* ---------- help overlay ---------- */
  .help { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,0.72); backdrop-filter: blur(6px);
    display: none; place-items: center; padding: 20px; }
  .help.show { display: grid; animation: fade .2s ease; }
  @keyframes fade { from { opacity: 0; } }
  .help-card { background: #0d0d15; border: 1px solid var(--border); border-radius: 18px;
    padding: 26px 30px; max-width: 440px; width: 100%; box-shadow: 0 30px 80px rgba(0,0,0,0.6); }
  .help-card h3 { margin: 0 0 6px; font-family: 'Space Grotesk', sans-serif; font-size: 1.4rem; }
  .help-card .sub { color: var(--muted); margin: 0 0 18px; font-size: 0.9rem; }
  .help-row { display: flex; justify-content: space-between; align-items: center; padding: 9px 0;
    border-top: 1px solid rgba(255,255,255,0.06); color: var(--muted); }
  .help-row b { color: var(--text); font-weight: 500; }
  kbd { background: #1b1b27; border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 6px;
    padding: 3px 9px; font-family: 'SF Mono', monospace; color: #fff; font-size: 0.82rem; }
  .help-close { margin-top: 18px; width: 100%; padding: 12px; border-radius: 12px; cursor: pointer;
    border: none; background: #fff; color: #0a0a12; font-weight: 700; }

  .help-fab { position: fixed; right: 18px; top: 18px; z-index: 55;
    width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--border); cursor: pointer;
    background: rgba(18,18,28,0.9); color: var(--text); backdrop-filter: blur(10px); font-size: 1rem;
    transition: all .15s; box-shadow: 0 8px 20px rgba(0,0,0,0.4); }
  .help-fab:hover { border-color: var(--accent); transform: translateY(-2px); }
</style>
</head>
<body>
  <div class="aurora"><span class="b1"></span><span class="b2"></span><span class="b3"></span><span class="b4"></span></div>
  <div class="grain"></div>

  <!-- school of swimming 3D silverbass -->
  <div class="ocean" id="ocean">
    <div class="fish"     style="top: 12%; width: 190px; animation-duration: 26s; animation-delay: -4s;  opacity: .9;"><img class="bob" src="silverbass-fish.png?v=2" alt="" /></div>
    <div class="fish rtl" style="top: 34%; width: 120px; animation-duration: 34s; animation-delay: -12s; opacity: .5; filter: blur(1px);"><img class="bob" src="silverbass-fish.png?v=2" alt="" /></div>
    <div class="fish"     style="top: 58%; width: 250px; animation-duration: 30s; animation-delay: -20s; opacity: .85;"><img class="bob" src="silverbass-fish.png?v=2" alt="" /></div>
    <div class="fish rtl" style="top: 72%; width: 150px; animation-duration: 22s; animation-delay: -2s;  opacity: .7;"><img class="bob" src="silverbass-fish.png?v=2" alt="" /></div>
    <div class="fish"     style="top: 86%; width: 95px;  animation-duration: 40s; animation-delay: -16s; opacity: .4; filter: blur(2px);"><img class="bob" src="silverbass-fish.png?v=2" alt="" /></div>
  </div>

  <div class="wrap">
    <header class="hero">
      <span class="eyebrow"><span class="dot"></span> Updated {{ updated }}</span>
      <h1 class="logo">{{ meta.title }}</h1>
      <p class="tagline">{{ meta.tagline }}</p>
      <div class="stats">
        <div class="stat"><b>{{ total_tracks }}</b><span>Tracks</span></div>
        <div class="stat"><b>{{ total_sets }}</b><span>Playlists</span></div>
        <div class="stat"><b>∞</b><span>Replays</span></div>
      </div>
    </header>

    <div class="toolbar">
      <div class="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="search" type="search" placeholder="Search songs or artists…  ( / )" autocomplete="off" />
      </div>
      <div class="chips" id="chips">
        <button class="chip active" data-filter="all">All</button>
        <button class="chip" data-filter="liked">❤️ Liked</button>
        {% for p in playlists %}
        <button class="chip" data-filter="{{ p.slug }}">{{ p.emoji }} {{ p.theme }}</button>
        {% endfor %}
      </div>
      <button class="ghost-btn" id="surprise" title="Play a random track">
        🎲 Surprise me
      </button>
      <button class="shuffle-all" id="shuffleAll">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="m15 15 6 6"/><path d="M4 4l5 5"/></svg>
        Shuffle
      </button>
    </div>

    {% for p in playlists %}
    <section class="set" id="{{ p.slug }}" data-slug="{{ p.slug }}">
      <div class="set-head" style="--card-accent: {{ p.accent }}">
        <span class="emoji">{{ p.emoji }}</span>
        <h2>{{ p.theme }}</h2>
        {% if p.genre %}<span class="genre">{{ p.genre }}</span>{% endif %}
        <span class="count">{{ p.tracks | length }} tracks</span>
      </div>
      <div class="grid">
        {% for t in p.tracks %}
        <article class="card" data-id="{{ t.video_id or '' }}" data-title="{{ t.title }}" data-artist="{{ t.artist }}"
                 data-cover="{{ t.cover }}" data-url="{{ t.url }}"
                 style="--card-accent: {{ p.accent }}">
          <div class="thumb">
            {% if t.cover %}<img src="{{ t.cover }}" alt="{{ t.title }} cover" loading="lazy" />{% endif %}
            <button class="like" data-id="{{ t.video_id or '' }}" title="Save to Liked" aria-label="Like">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </button>
            <div class="play-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </div>
          </div>
          <div class="card-meta">
            <div class="t">{{ t.title }}</div>
            <div class="a">{{ t.artist }}</div>
            <div class="eq"><i></i><i></i><i></i><i></i></div>
          </div>
        </article>
        {% endfor %}
      </div>
    </section>
    {% endfor %}

    <div class="empty" id="empty">No tracks match that search. 🎧</div>

    <footer>
      <div class="socials">
        <a href="{{ meta.github }}" target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.2c-3.34.73-4.04-1.6-4.04-1.6-.55-1.4-1.34-1.77-1.34-1.77-1.1-.75.08-.74.08-.74 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.23 1.91 1.23 3.23 0 4.63-2.8 5.65-5.48 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>
        </a>
        {% if meta.linkedin %}
        <a href="{{ meta.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
        {% endif %}
      </div>
      <p>Curated by {{ meta.curator }} · Built with Python, YAML &amp; a lot of late nights.</p>
    </footer>
  </div>

  <!-- now playing bar -->
  <div class="nowbar" id="nowbar">
    <div class="viz" id="viz"></div>
    <div class="nb-progress" id="progress"><div class="fill" id="fill"></div></div>
    <div class="nb-inner">
      <div class="nb-art">
        <img class="nb-cover" id="nbCover" alt="" />
        <div id="yt-player"></div>
      </div>
      <div class="nb-info">
        <div class="t" id="nbTitle">Nothing playing</div>
        <div class="a" id="nbArtist">Pick a track to start</div>
      </div>
      <div class="nb-controls">
        <button class="nb-btn" id="btnLike" title="Like (l)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
        <button class="nb-btn" id="btnShuffle" title="Shuffle (s)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="m15 15 6 6"/><path d="M4 4l5 5"/></svg>
        </button>
        <button class="nb-btn" id="btnPrev" title="Previous (←)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg>
        </button>
        <button class="nb-btn nb-play" id="btnPlay" title="Play / Pause (space)">
          <svg id="playIcon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <button class="nb-btn" id="btnNext" title="Next (→)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2zM6 18l8.5-6L6 6z"/></svg>
        </button>
        <button class="nb-btn" id="btnRepeat" title="Repeat (r)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/></svg>
        </button>
        <button class="nb-btn" id="btnShare" title="Share this track (c)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>
        </button>
      </div>
      <div class="nb-time"><span id="cur">0:00</span> / <span id="dur">0:00</span><a class="open" id="ytLink" target="_blank" rel="noopener">YouTube ↗</a></div>
    </div>
  </div>

  <!-- toast -->
  <div class="toast" id="toast"></div>

  <!-- keyboard shortcut helper -->
  <button class="help-fab" id="helpFab" title="Keyboard shortcuts (?)">?</button>
  <div class="help" id="help">
    <div class="help-card">
      <h3>Keyboard shortcuts</h3>
      <p class="sub">SilverBass moves faster with keys. 🎧</p>
      <div class="help-row"><b>Play / pause</b> <kbd>space</kbd></div>
      <div class="help-row"><b>Next track</b> <kbd>→</kbd></div>
      <div class="help-row"><b>Previous track</b> <kbd>←</kbd></div>
      <div class="help-row"><b>Shuffle</b> <kbd>s</kbd></div>
      <div class="help-row"><b>Repeat</b> <kbd>r</kbd></div>
      <div class="help-row"><b>Like current track</b> <kbd>l</kbd></div>
      <div class="help-row"><b>Copy share link</b> <kbd>c</kbd></div>
      <div class="help-row"><b>Search</b> <kbd>/</kbd></div>
      <div class="help-row"><b>This menu</b> <kbd>?</kbd></div>
      <button class="help-close" id="helpClose">Got it</button>
    </div>
  </div>

<script>
  const QUEUE = {{ queue | tojson }};
  const cards = Array.from(document.querySelectorAll('.card'));

  // map each card to its index in the (filterable) play order
  let order = cards.map((_, i) => i);
  let current = -1;
  let shuffle = false, repeat = false;
  let player = null, ready = false, pendingId = null, ticker = null;

  const $ = id => document.getElementById(id);
  const fmt = s => { s = Math.floor(s||0); return Math.floor(s/60)+':'+String(s%60).padStart(2,'0'); };

  /* ---------- YouTube IFrame API ---------- */
  const tag = document.createElement('script');
  tag.src = 'https://www.youtube.com/iframe_api';
  document.head.appendChild(tag);

  window.onYouTubeIframeAPIReady = function () {
    player = new YT.Player('yt-player', {
      height: '100%', width: '100%',
      playerVars: { autoplay: 1, controls: 0, playsinline: 1, rel: 0, modestbranding: 1 },
      events: {
        onReady: () => { ready = true; if (pendingId !== null) { play(pendingId); pendingId = null; } },
        onStateChange: onState,
        onError: (e) => { console.warn('YT error', e.data); if (current >= 0) next(); }
      }
    });
  };

  function onState(e) {
    if (e.data === YT.PlayerState.PLAYING) { setPlayIcon(true); startTicker(); }
    else if (e.data === YT.PlayerState.PAUSED) { setPlayIcon(false); stopTicker(); }
    else if (e.data === YT.PlayerState.ENDED) {
      if (repeat) play(current); else next();
    }
  }

  function setPlayIcon(playing) {
    $('playIcon').innerHTML = playing
      ? '<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>'
      : '<path d="M8 5v14l11-7z"/>';
    $('nowbar').classList.toggle('playing', playing);
  }

  function startTicker() {
    stopTicker();
    ticker = setInterval(() => {
      if (!player || !player.getDuration) return;
      const d = player.getDuration(), c = player.getCurrentTime();
      $('fill').style.width = d ? (c/d*100)+'%' : '0%';
      $('cur').textContent = fmt(c); $('dur').textContent = fmt(d);
    }, 400);
  }
  function stopTicker() { clearInterval(ticker); }

  /* ---------- playback ---------- */
  function play(i) {
    const card = cards[i];
    if (!card) return;
    const id = card.dataset.id;
    current = i;
    document.documentElement.style.setProperty('--accent', card.style.getPropertyValue('--card-accent') || '#7c5cff');
    cards.forEach(c => c.classList.remove('playing'));
    card.classList.add('playing');

    $('nowbar').classList.add('show');
    $('nbTitle').textContent = card.dataset.title;
    $('nbArtist').textContent = card.dataset.artist;
    $('nbCover').src = card.dataset.cover || '';
    $('ytLink').href = card.dataset.url;
    updateLikeUI();
    showToast('Now playing', card.dataset.title, card.dataset.artist);
    try { localStorage.setItem('sb_last', id); } catch (e) {}

    if (!id) { window.open(card.dataset.url, '_blank'); return; }
    if (!ready) { pendingId = i; return; }
    player.loadVideoById(id);
  }

  function visibleOrder() {
    return cards.map((c,i)=>({c,i})).filter(x => x.c.style.display !== 'none').map(x => x.i);
  }

  function step(dir) {
    const vis = visibleOrder();
    if (!vis.length) return;
    if (shuffle) { play(vis[Math.floor(Math.random()*vis.length)]); return; }
    const pos = vis.indexOf(current);
    let nextPos = pos + dir;
    if (nextPos >= vis.length) nextPos = 0;
    if (nextPos < 0) nextPos = vis.length - 1;
    play(vis[nextPos]);
  }
  const next = () => step(1);
  const prev = () => step(-1);

  function toggle() {
    if (!player || current < 0) { const v = visibleOrder(); if (v.length) play(v[0]); return; }
    const st = player.getPlayerState();
    if (st === YT.PlayerState.PLAYING) player.pauseVideo(); else player.playVideo();
  }

  /* ---------- wire up cards & controls ---------- */
  cards.forEach((card, i) => card.addEventListener('click', () => play(i)));
  $('btnPlay').onclick = toggle;
  $('btnNext').onclick = next;
  $('btnPrev').onclick = prev;
  $('btnShuffle').onclick = e => { shuffle = !shuffle; e.currentTarget.classList.toggle('active', shuffle); };
  $('btnRepeat').onclick = e => { repeat = !repeat; e.currentTarget.classList.toggle('active', repeat); };
  $('shuffleAll').onclick = () => { shuffle = true; $('btnShuffle').classList.add('active'); const v=visibleOrder(); if(v.length) play(v[Math.floor(Math.random()*v.length)]); };

  $('progress').addEventListener('click', e => {
    if (!player || !player.getDuration) return;
    const r = e.currentTarget.getBoundingClientRect();
    player.seekTo(player.getDuration() * ((e.clientX - r.left)/r.width), true);
  });

  /* ---------- search + filter ---------- */
  const search = $('search'), chips = Array.from(document.querySelectorAll('.chip'));
  let activeFilter = 'all';

  function applyFilter() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    document.querySelectorAll('section.set').forEach(sec => {
      let secShown = 0;
      sec.querySelectorAll('.card').forEach(card => {
        const matchText = (card.dataset.title + ' ' + card.dataset.artist).toLowerCase().includes(q);
        const matchChip = activeFilter === 'all' ? true
          : (activeFilter === 'liked' ? isLiked(card.dataset.id) : sec.dataset.slug === activeFilter);
        const ok = matchText && matchChip;
        card.style.display = ok ? '' : 'none';
        if (ok) { secShown++; shown++; }
      });
      sec.style.display = secShown ? '' : 'none';
    });
    $('empty').style.display = shown ? 'none' : 'block';
  }

  search.addEventListener('input', applyFilter);
  chips.forEach(chip => chip.addEventListener('click', () => {
    chips.forEach(c => c.classList.remove('active'));
    chip.classList.add('active');
    activeFilter = chip.dataset.filter;
    applyFilter();
  }));

  /* ---------- keyboard ---------- */
  document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT') { if (e.key === 'Escape') e.target.blur(); return; }
    if (e.key === 'Escape') { $('help').classList.remove('show'); return; }
    if (e.key === '?' || (e.shiftKey && e.key === '/')) { e.preventDefault(); $('help').classList.toggle('show'); }
    else if (e.key === '/') { e.preventDefault(); search.focus(); }
    else if (e.code === 'Space') { e.preventDefault(); toggle(); }
    else if (e.key === 'ArrowRight') next();
    else if (e.key === 'ArrowLeft') prev();
    else if (e.key.toLowerCase() === 's') $('btnShuffle').click();
    else if (e.key.toLowerCase() === 'r') $('btnRepeat').click();
    else if (e.key.toLowerCase() === 'l') $('btnLike').click();
    else if (e.key.toLowerCase() === 'c') shareCurrent();
  });

  /* ---------- toast ---------- */
  let toastT = null;
  function showToast(title, sub, sub2) {
    const t = $('toast');
    const main = document.createElement('b'); main.textContent = title;
    t.innerHTML = ''; t.appendChild(main);
    if (sub) { const s = document.createElement('span'); s.textContent = ' ' + sub + (sub2 ? ' — ' + sub2 : ''); t.appendChild(s); }
    t.classList.add('show');
    clearTimeout(toastT);
    toastT = setTimeout(() => t.classList.remove('show'), 2600);
  }

  /* ---------- likes (saved in this browser) ---------- */
  const LIKES_KEY = 'sb_likes';
  let likes = new Set();
  try { likes = new Set(JSON.parse(localStorage.getItem(LIKES_KEY) || '[]')); } catch (e) {}
  function saveLikes() { try { localStorage.setItem(LIKES_KEY, JSON.stringify([...likes])); } catch (e) {} }
  function isLiked(id) { return !!id && likes.has(id); }
  function toggleLike(id) {
    if (!id) return;
    likes.has(id) ? likes.delete(id) : likes.add(id);
    saveLikes(); refreshLikeButtons(); updateLikeUI();
    if (activeFilter === 'liked') applyFilter();
  }
  function refreshLikeButtons() {
    document.querySelectorAll('.card .like').forEach(b => b.classList.toggle('liked', isLiked(b.dataset.id)));
  }
  function updateLikeUI() {
    const id = current >= 0 ? cards[current].dataset.id : null;
    $('btnLike').classList.toggle('liked', isLiked(id));
  }
  document.querySelectorAll('.card .like').forEach(btn => btn.addEventListener('click', e => {
    e.stopPropagation();
    toggleLike(btn.dataset.id);
    showToast(isLiked(btn.dataset.id) ? '❤️ Added to Liked' : 'Removed from Liked', '', '');
  }));
  $('btnLike').onclick = () => { if (current < 0) return; toggleLike(cards[current].dataset.id); };
  refreshLikeButtons();

  /* ---------- share / deep links ---------- */
  function shareCurrent() {
    if (current < 0) { showToast('Pick a track first 🎧', '', ''); return; }
    const card = cards[current];
    const url = location.origin + location.pathname + '?t=' + card.dataset.id;
    const data = { title: card.dataset.title + ' — ' + card.dataset.artist, text: 'Vibe to this on SilverBass 🎧', url };
    if (navigator.share) { navigator.share(data).catch(() => {}); }
    else if (navigator.clipboard) { navigator.clipboard.writeText(url).then(() => showToast('🔗 Link copied — share the vibe!', '', '')); }
    else { showToast('Share link', url, ''); }
  }
  $('btnShare').onclick = shareCurrent;

  /* ---------- surprise me ---------- */
  $('surprise').onclick = () => {
    const v = visibleOrder();
    const pool = v.length ? v : cards.map((_, i) => i);
    play(pool[Math.floor(Math.random() * pool.length)]);
    showToast('🎲 Surprise pick!', '', '');
  };

  /* ---------- visualizer bars ---------- */
  (function () {
    const viz = $('viz');
    for (let i = 0; i < 48; i++) {
      const b = document.createElement('i');
      b.style.animationDelay = (Math.random() * 0.9).toFixed(2) + 's';
      b.style.animationDuration = (0.6 + Math.random() * 0.85).toFixed(2) + 's';
      viz.appendChild(b);
    }
  })();

  /* ---------- bubbles ---------- */
  function makeBubble(burst) {
    const o = $('ocean');
    const b = document.createElement('div');
    b.className = 'bubble';
    const size = 6 + Math.random() * (burst ? 16 : 22);
    b.style.width = b.style.height = size + 'px';
    b.style.left = (Math.random() * 100) + 'vw';
    const dur = burst ? (2.5 + Math.random() * 2) : (8 + Math.random() * 8);
    b.style.animationDuration = dur + 's';
    if (burst) b.style.bottom = (Math.random() * 35) + 'vh';
    o.appendChild(b);
    setTimeout(() => b.remove(), dur * 1000);
  }
  setInterval(() => makeBubble(false), 1500);
  for (let i = 0; i < 6; i++) setTimeout(() => makeBubble(false), i * 350);

  /* ---------- clickable fish easter egg ---------- */
  let frenzyT = null;
  document.querySelectorAll('.fish').forEach(f => f.addEventListener('click', () => {
    document.querySelectorAll('.fish').forEach(fish => {
      const cur = parseFloat(getComputedStyle(fish).animationDuration) || 26;
      if (!fish.dataset.normDur) fish.dataset.normDur = cur;
      fish.style.animationDuration = (parseFloat(fish.dataset.normDur) / 3.2) + 's';
    });
    for (let i = 0; i < 16; i++) setTimeout(() => makeBubble(true), i * 55);
    showToast('🐟 Feeding frenzy!', 'The bass picked a track for you', '');
    const v = visibleOrder();
    const pool = v.length ? v : cards.map((_, i) => i);
    play(pool[Math.floor(Math.random() * pool.length)]);
    clearTimeout(frenzyT);
    frenzyT = setTimeout(() => document.querySelectorAll('.fish').forEach(fish => {
      if (fish.dataset.normDur) fish.style.animationDuration = fish.dataset.normDur + 's';
    }), 5000);
  }));

  /* ---------- help overlay ---------- */
  $('helpFab').onclick = () => $('help').classList.toggle('show');
  $('helpClose').onclick = () => $('help').classList.remove('show');
  $('help').addEventListener('click', e => { if (e.target === $('help')) $('help').classList.remove('show'); });

  /* ---------- deep link: ?t=VIDEO_ID auto-plays ---------- */
  (function () {
    const t = new URLSearchParams(location.search).get('t');
    if (!t) return;
    const idx = cards.findIndex(c => c.dataset.id === t);
    if (idx < 0) return;
    setTimeout(() => { play(idx); cards[idx].scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 450);
  })();
</script>
</body>
</html>
